set number
syntax on
colorscheme default
set t_Co=256
set nowrap
:map <C-PageUp> <C-b>
:map <C-PageDown> <C-f>
set mouse=a
filetype plugin indent on
set tabstop=4        " Dimensiunea unei tabulări
set shiftwidth=4     " Dimensiunea indentării pentru << și >>
set expandtab        " Convertește tab-urile în spații

